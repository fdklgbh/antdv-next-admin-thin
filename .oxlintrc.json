{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["vue", "typescript", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["src/vite-env.d.ts", "src/views/about/index.vue", "vite.config.ts"],
      "rules": {
        "no-underscore-dangle": ["warn", { "allow": ["__APP_VERSION__"] }]
      }
    },
    {
      "files": ["src/utils/request.ts"],
      "rules": {
        "no-underscore-dangle": ["warn", { "allow": ["_retry"] }]
      }
    },
    {
      "files": ["src/components/Pro/ProTable/index.vue"],
      "rules": {
        "no-underscore-dangle": [
          "warn",
          { "allow": ["__proHeaderFilter", "__proHeaderFilterKey"] }
        ]
      }
    },
    {
      "files": ["mock/**/*"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
